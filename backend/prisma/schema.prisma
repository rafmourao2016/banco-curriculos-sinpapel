generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// FASE 1 — Cadastro do candidato (implementado neste MVP)
// ---------------------------------------------------------------------------

model Candidato {
  id                     String    @id @default(uuid()) @db.Uuid
  nome                   String
  cpf                    String    @unique
  email                  String    @unique
  telefone               String
  dataNascimento         DateTime  @map("data_nascimento")
  regiao                 String
  uf                     String?
  escolaridade           Escolaridade
  possuiCnh              Boolean   @default(false) @map("possui_cnh")
  categoriaCnh           String?   @map("categoria_cnh")
  areaPretendida         String?   @map("area_pretendida")
  cargoPretendido        String?   @map("cargo_pretendido")
  pretensaoSalarial      String?   @map("pretensao_salarial")
  experienciaSetorPapel  Boolean?  @map("experiencia_setor_papel")
  anosExperienciaTotal   String?   @map("anos_experiencia_total")
  turnos                 String[]  @default([])
  inicioImediato         Boolean?  @map("inicio_imediato")
  disponibilidadeMudanca Boolean?  @map("disponibilidade_mudanca")
  cursosCertificacoes    String[]  @default([]) @map("cursos_certificacoes")
  idiomas                String[]  @default([])
  pcd                    Boolean?
  pcdObservacao          String?   @map("pcd_observacao")
  embedding              Unsupported("vector")?
  senhaHash              String    @map("senha_hash")
  ativo                  Boolean   @default(true)
  dataInativacao         DateTime? @map("data_inativacao")
  dataCadastro           DateTime  @default(now()) @map("data_cadastro")
  dataUltimaRevalidacao  DateTime  @default(now()) @map("data_ultima_revalidacao")

  experiencias           Experiencia[]
  formacoes              Formacao[]
  habilidades            CandidatoHabilidade[]
  statusContratacoes     StatusContratacao[]
  logsVisualizacao       LogVisualizacao[]
  notificacoes           Notificacao[]
  termoConsentimento     TermoConsentimento?

  @@map("candidatos")
}

enum Escolaridade {
  FUNDAMENTAL_INCOMPLETO
  FUNDAMENTAL_COMPLETO
  MEDIO_INCOMPLETO
  MEDIO_COMPLETO
  SUPERIOR_INCOMPLETO
  SUPERIOR_COMPLETO
  POS_GRADUACAO
}

model Experiencia {
  id           String    @id @default(uuid()) @db.Uuid
  candidatoId  String    @map("candidato_id") @db.Uuid
  candidato    Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  empresa      String?
  cargo        String
  area         String
  dataInicio   DateTime  @map("data_inicio")
  dataFim      DateTime? @map("data_fim")
  descricao    String?

  @@map("experiencias")
}

model Formacao {
  id           String    @id @default(uuid()) @db.Uuid
  candidatoId  String    @map("candidato_id") @db.Uuid
  candidato    Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  nivel        String
  curso        String
  instituicao  String
  status       String // "concluído" | "cursando" | "trancado"
  ano          Int?

  @@map("formacoes")
}

model TermoConsentimento {
  id           String    @id @default(uuid()) @db.Uuid
  candidatoId  String    @unique @map("candidato_id") @db.Uuid
  candidato    Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  versao       String
  dataAceite   DateTime  @default(now()) @map("data_aceite")
  ip           String

  @@map("termos_consentimento")
}

// ---------------------------------------------------------------------------
// FASE 3+ — Empresas, busca e status de contratação (modelado, não exposto ainda)
// ---------------------------------------------------------------------------

model Empresa {
  id               String   @id @default(uuid()) @db.Uuid
  razaoSocial      String   @map("razao_social")
  cnpj             String   @unique
  email            String   @unique
  senhaHash        String   @map("senha_hash")
  statusAprovacao  String   @default("pendente") @map("status_aprovacao")
  twoFaAtivo       Boolean  @default(false) @map("two_fa_ativo")
  twoFaSecret      String?  @map("two_fa_secret")

  usuarios             UsuarioEmpresa[]
  vagasNecessidade      VagaNecessidade[]
  statusContratacoes    StatusContratacao[]
  logsVisualizacao      LogVisualizacao[]
  apiKeys               EmpresaApiKey[]

  @@map("empresas")
}

model EmpresaApiKey {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome        String
  tokenPrefix String   @map("token_prefix")
  tokenHash   String   @map("token_hash")
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  @@map("empresas_api_keys")
}

model UsuarioEmpresa {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  email      String   @unique
  papel      String   @default("operador") // "admin_empresa" | "operador"

  @@map("usuarios_empresa")
}

model VagaNecessidade {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  area         String
  requisitos   String
  ativa        Boolean  @default(true)

  @@map("vagas_necessidade")
}

model StatusContratacao {
  id                String    @id @default(uuid()) @db.Uuid
  candidatoId       String    @map("candidato_id") @db.Uuid
  candidato         Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  empresaId         String    @map("empresa_id") @db.Uuid
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  status            StatusCandidatura @default(CONTATADO)
  dataAdmissao      DateTime? @map("data_admissao")
  comentario        String?
  dataAtualizacao   DateTime  @default(now()) @updatedAt @map("data_atualizacao")

  @@unique([candidatoId, empresaId])
  @@map("status_contratacao")
}

enum StatusCandidatura {
  CONTATADO
  EM_PROCESSO_SELETIVO
  CONTRATADO
  NAO_COMPATIVEL
}

model LogVisualizacao {
  id           String    @id @default(uuid()) @db.Uuid
  candidatoId  String    @map("candidato_id") @db.Uuid
  candidato    Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  empresaId    String    @map("empresa_id") @db.Uuid
  empresa      Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dataHora     DateTime  @default(now()) @map("data_hora")

  @@map("logs_visualizacao")
}

model Notificacao {
  id            String    @id @default(uuid()) @db.Uuid
  candidatoId   String    @map("candidato_id") @db.Uuid
  candidato     Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  tipo          String // "revalidacao" | "alerta_reverso" | "geral"
  canal         String // "whatsapp" | "email"
  statusEnvio   String    @default("pendente") @map("status_envio")
  dataEnvio     DateTime  @default(now()) @map("data_envio")
  tokenHash     String?   @unique @map("token_hash")
  expiraEm      DateTime? @map("expira_em")
  usadoEm       DateTime? @map("usado_em")
  erroEnvio     String?   @map("erro_envio")

  @@map("notificacoes")
}

model Habilidade {
  id        String                 @id @default(uuid()) @db.Uuid
  nome      String                 @unique
  embedding Unsupported("vector")?

  candidatos  CandidatoHabilidade[]

  @@map("habilidades")
}

model CandidatoHabilidade {
  candidatoId    String     @map("candidato_id") @db.Uuid
  candidato      Candidato  @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  habilidadeId   String     @map("habilidade_id") @db.Uuid
  habilidade     Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([candidatoId, habilidadeId])
  @@map("candidatos_habilidades")
}

model RecuperacaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  tipo      String
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([email, tipo])
  @@map("recuperacoes_senha")
}
